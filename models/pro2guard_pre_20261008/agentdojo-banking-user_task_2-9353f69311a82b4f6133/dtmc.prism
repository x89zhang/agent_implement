    [] s=0 -> 1/24 : (s'=0) + 21/24 : (s'=1) + 1/24 : (s'=2) + 1/24 : (s'=3);
    [] s=1 -> 1/135 : (s'=0) + 100/135 : (s'=1) + 1/135 : (s'=2) + 33/135 : (s'=3);
    [] s=2 -> 1/49 : (s'=0) + 1/49 : (s'=1) + 38/49 : (s'=2) + 9/49 : (s'=3);
    [] s=3 -> 1.0 : (s'=3);
